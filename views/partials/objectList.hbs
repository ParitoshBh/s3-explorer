<script>
  function updateActionVisibility() {
    const anyChecked = document.querySelectorAll('.table-selectable-check:checked').length > 0;
    const action = document.getElementById('action');
    action.style.display = anyChecked ? 'block' : 'none';
  }

  document.querySelectorAll('.table-selectable-check').forEach(checkbox => {
    checkbox.addEventListener('change', updateActionVisibility);
  });

  async function deleteSelectedItems() {
    const selected = Array.from(document.querySelectorAll('.table-selectable-check:checked'))
      .map(checkbox => checkbox.value);

    if (selected.length === 0) {
      alert('No items selected.');
      return;
    }

    try {
      await fetch("/buckets/{{ @root.bucketName }}/objects", {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ keys: selected }),
      });
      window.location.href = '/';
    } catch (e) {
      console.error('Error:', error);
      alert('An error occurred while deleting items.');
    }
  }
</script>